# Salin file ini ke ".env" lalu isi dengan kredensial project Supabase kamu.
# Ambil dari: Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# PIN rumah tangga (angka). Diminta sekali per device saat install.
# Tambahkan juga sebagai GitHub Actions secret: VITE_HOUSEHOLD_PIN
VITE_HOUSEHOLD_PIN=1234
